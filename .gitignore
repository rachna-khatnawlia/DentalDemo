# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# Android build artifacts & local configs
android/build/
android/app/build/
android/.gradle/
android/.idea/
android/*.iml
android/app/*.iml
android/local.properties
android/captures/
android/.cxx/
android/.kotlin/
